# Supabase project
# Lấy ở Supabase Dashboard > Project Settings > API
# (tên biến mới; các tên cũ ANON_KEY / SERVICE_ROLE_KEY vẫn được hỗ trợ)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Secret key (còn gọi là service_role key) — chỉ dùng ở server, KHÔNG đưa lên trình duyệt.
# Không bắt buộc để app chạy; cần khi bạn tự chạy script quản trị dữ liệu.
SUPABASE_SECRET_KEY=your-secret-key
